# =============================================================================
# Real-Time E-Commerce Data Pipeline - Environment Configuration
# Copy this file to .env and adjust values as needed.
# =============================================================================

# --- Apache Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_EVENTS_TOPIC=ecommerce-events
KAFKA_DLQ_TOPIC=ecommerce-events-dlq
KAFKA_TOPIC_PARTITIONS=3
KAFKA_REPLICATION_FACTOR=1
KAFKA_CONSUMER_GROUP=ecommerce-debug-group

# --- Data Generator ---
EVENT_GENERATION_INTERVAL_SEC=0.5
INVALID_EVENT_RATE=0.05

# --- Apache Spark ---
SPARK_APP_NAME=EcommerceRealtimePipeline
SPARK_MASTER=local[*]
SPARK_CHECKPOINT_DIR=./checkpoints/ecommerce_stream
SPARK_WATERMARK_DELAY=2 minutes
SPARK_WINDOW_DURATION=1 minute
SPARK_SHUFFLE_PARTITIONS=4

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ecommerce_analytics
POSTGRES_USER=pipeline_user
POSTGRES_PASSWORD=pipeline_pass

# --- Logging ---
LOG_LEVEL=INFO
